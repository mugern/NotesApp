<Window x:Class="NotesApp.Views.CreateFolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NotesApp.Views"
        mc:Ignorable="d"
        Title="Создать папку" Height="500" Width="662"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="Создать папку" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
        
        <TextBox Grid.Row="1" x:Name="FolderNameTextBox" Height="30" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"
                 Style="{StaticResource MaterialDesignTextBox}" Text="Новая папка"/>
        
        <TextBlock Grid.Row="2" Text="Выберите заметки для добавления в папку:" FontSize="14" Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,20,0,10" Background="DarkSlateBlue">
            <WrapPanel x:Name="NotesPanel" Margin="0,0,0,10">
                <!-- Динамически создаваемые элементы заметок будут здесь -->
            </WrapPanel>
        </ScrollViewer>
        
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="CreateButton" Content="Создать" Width="105" Height="30" Margin="0,0,10,0" Click="CreateButton_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}" Background="LightBlue" Foreground="DarkBlue"/>
            <Button x:Name="CancelButton" Content="Отмена" Width="109" Height="30" Click="CancelButton_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}" Background="LightGray" Foreground="Black"/>
        </StackPanel>
    </Grid>
</Window>