<Window x:Class="NotesApp.Views.TrashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NotesApp.Views"
        mc:Ignorable="d"
        Title="Корзина" Height="500" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="Корзина" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
        
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="TrashNotesPanel" Margin="0,0,0,10" Background="DarkSlateBlue">
                <!-- Динамически создаваемые элементы удаленных заметок будут здесь -->
            </WrapPanel>
        </ScrollViewer>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="RestoreButton" Content="Восстановить" Width="131" Height="30" Margin="0,0,10,0" Click="RestoreButton_Click" IsEnabled="False"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="LightGreen" Foreground="DarkGreen"/>
            <Button x:Name="RestoreToFolderButton" Content="Восстановить в папку" Width="190" Height="30" Margin="0,0,10,0" Click="RestoreToFolderButton_Click" IsEnabled="False"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="LightBlue" Foreground="DarkBlue"/>
            <Button x:Name="DeletePermanentlyButton" Content="Удалить навсегда" Width="190" Height="30" Click="DeletePermanentlyButton_Click" IsEnabled="False"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="LightCoral" Foreground="DarkRed"/>
        </StackPanel>
    </Grid>
</Window>